# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings → Environment Variables instead.

# Password HR/admins use to log into /admin. Required.
ADMIN_PASSWORD=jimto-hr-2026

# Optional locally. Without these, admin edits are saved to a local file at
# .data/site-content.json instead of Redis — fine for development, but on a
# real deployment (Vercel, etc.) you MUST set these or admin edits will not
# persist. Get them for free from the Vercel dashboard: Storage tab → create
# a KV/Redis database → connect it to this project (Vercel injects these two
# automatically). Or create one directly at https://upstash.com.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Lark Base — nhận hồ sơ ứng tuyển từ form "Ứng tuyển" trên website.
# Tạo app tại open.larksuite.com, cấp quyền Bitable (đọc + ghi record), rồi
# thêm app đó làm cộng tác viên (quyền chỉnh sửa) của Base bên dưới.
LARK_APP_ID=
LARK_APP_SECRET=
# Lấy từ URL của Base: .../base/<LARK_BASE_APP_TOKEN>?...
LARK_BASE_APP_TOKEN=
# Tên bảng (table) trong Base sẽ nhận hồ sơ ứng tuyển
LARK_TABLE_NAME=Danh sách ứng tuyển qua web
